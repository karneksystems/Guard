{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wideberth.app/schema/firm-pack.v1.json",
  "title": "Firm rule pack, version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "firmId", "firmName", "packVersion", "sourceUrl",
    "sourceFetchedAt", "lastVerified", "verifiedBy", "needsReverify",
    "investorPasswordAllowed", "accountTypes", "changelog"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "firmId": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
    "firmName": { "type": "string", "minLength": 1 },
    "packVersion": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}(-[a-z0-9.]+)?$" },
    "sourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "sourceFetchedAt": { "type": ["string", "null"], "format": "date-time" },
    "lastVerified": { "type": ["string", "null"], "format": "date" },
    "verifiedBy": { "type": ["string", "null"], "minLength": 1 },
    "needsReverify": { "type": "boolean" },
    "investorPasswordAllowed": { "enum": ["yes", "no", "unknown"] },
    "investorPasswordSourceUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "accountTypes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/accountType" }
    },
    "changelog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["packVersion", "date", "change"],
        "properties": {
          "packVersion": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "change": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "needsReverify": { "const": false } } },
      "then": {
        "properties": {
          "lastVerified": { "type": "string" },
          "verifiedBy": { "type": "string" },
          "sourceFetchedAt": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "investorPasswordAllowed": { "const": "yes" } } },
      "then": { "required": ["investorPasswordSourceUrl"] }
    }
  ],
  "$defs": {
    "accountType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "phase", "newsRule"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
        "label": { "type": "string", "minLength": 1 },
        "phase": { "enum": ["evaluation", "funded", "instant"] },
        "newsRule": { "$ref": "#/$defs/newsRule" }
      }
    },
    "newsRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies"],
      "properties": {
        "applies": { "type": "boolean" },
        "windowBeforeMin": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "windowAfterMin": { "type": "integer", "minimum": 0, "maximum": 1440 },
        "eventSet": { "enum": ["firm-list", "calendar-high-impact"] },
        "eventListUrl": { "type": ["string", "null"], "format": "uri" },
        "affectedInstruments": { "enum": ["event-currency", "all", "list"] },
        "instruments": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "restrictedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["open", "close", "modify"] }
        },
        "slTpTriggerCounts": { "type": "boolean" },
        "holdingThroughAllowed": { "type": "boolean" },
        "consequence": { "enum": ["breach", "termination", "profit-removed", "profit-reduced", "none"] },
        "countedShare": { "type": "number", "minimum": 0, "maximum": 1 },
        "exemptIfOpenedMinutesBefore": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "applies": { "const": true } } },
          "then": {
            "required": [
              "windowBeforeMin", "windowAfterMin", "eventSet", "affectedInstruments",
              "restrictedActions", "slTpTriggerCounts", "holdingThroughAllowed", "consequence"
            ]
          }
        },
        {
          "if": { "properties": { "consequence": { "const": "profit-reduced" } }, "required": ["consequence"] },
          "then": { "required": ["countedShare"] }
        },
        {
          "if": { "properties": { "affectedInstruments": { "const": "list" } }, "required": ["affectedInstruments"] },
          "then": { "required": ["instruments"] }
        }
      ]
    }
  }
}
