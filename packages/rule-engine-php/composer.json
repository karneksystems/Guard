{
  "name": "karnek/rule-engine",
  "description": "Rule engine for the prop-firm news guard. Pure PHP, no framework. Must match fixtures/rule-engine.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "Karnek\\RuleEngine\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Karnek\\RuleEngine\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": false,
    "sort-packages": true
  }
}
